<section id="waarom-prologg" class="why-section">
    <div class="why-content">
        <header>
            {% from "macros/Sectiontitle.njk" import titleSet %}
            {{ titleSet(title=why.heading, subtitle=why.subtitle) }}
        </header>
        <dl class="why-reasons">
            {% for reason in why.reasons %}
                <dt>{{ reason.title }}</dt>
                <dd>{{ reason.description }}</dd>
            {% endfor %}
        </dl>
    </div>
</section>